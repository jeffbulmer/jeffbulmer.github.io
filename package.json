{
  "name": "andresjosehr-portfolio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build-portfolio": "ng build --configuration production",
    "build:prod": "ng build --configuration production --base-href https://jkbulmer.me/",
    "postbuild:prod": "cp .nojekyll dist/andresjosehr-portfolio/browser/ && cp CNAME dist/andresjosehr-portfolio/browser/",
    "deploy": "npm run build:prod && npm run postbuild:prod && ngh --dir=dist/andresjosehr-portfolio/browser --cname=jkbulmer.me",
    "deploy:ci": "npm run postbuild:prod && ngh --dir=dist/andresjosehr-portfolio/browser --cname=jkbulmer.me --no-silent",
    "predeploy": "npm run build:prod",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.3.33",
    "@angular/common": "20.3.33",
    "@angular/compiler": "20.3.33",
    "@angular/core": "20.3.33",
    "@angular/forms": "20.3.33",
    "@angular/localize": "20.3.33",
    "@angular/platform-browser": "20.3.33",
    "@angular/platform-browser-dynamic": "20.3.33",
    "@angular/router": "20.3.33",
    "@angular/service-worker": "20.3.33",
    "@fortawesome/fontawesome-free": "^5.14.0",
    "@ng-bootstrap/ng-bootstrap": "^19.0.1",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^6.0.0",
    "@popperjs/core": "^2.11.8",
    "aos": "^2.3.4",
    "bootstrap": "^4.5.0",
    "lenis": "^1.3.4",
    "lottie-web": "^5.13.0",
    "ngx-google-analytics": "^11.2.0",
    "ngx-owl-carousel-o": "^20.0.0",
    "rxjs": "~6.5.5",
    "tslib": "^2.0.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.3.39",
    "@angular/cli": "20.3.39",
    "@angular/compiler-cli": "20.3.33",
    "@types/node": "^20.19.0",
    "angular-cli-ghpages": "^3.1.2",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage-istanbul-reporter": "~3.0.2",
    "typescript": "~5.8.3"
  }
}
