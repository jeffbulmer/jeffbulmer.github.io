{
  "name": "jeffbulmer-portfolio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production --base-href https://jeffbulmer.github.io/",
    "postbuild:prod": "cp .nojekyll dist/jeffbulmer-portfolio/browser/",
    "deploy": "npm run build:prod && npm run postbuild:prod && ngh --dir=dist/jeffbulmer-portfolio/browser",
    "deploy:ci": "npm run postbuild:prod && ngh --dir=dist/jeffbulmer-portfolio/browser --no-silent",
    "predeploy": "npm run build:prod"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.3.33",
    "@angular/common": "20.3.33",
    "@angular/compiler": "20.3.33",
    "@angular/core": "20.3.33",
    "@angular/platform-browser": "20.3.33",
    "@fortawesome/fontawesome-free": "^5.14.0",
    "bootstrap": "^4.5.0",
    "lottie-web": "^5.13.0",
    "rxjs": "~6.5.5",
    "tslib": "^2.0.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.3.39",
    "@angular/cli": "20.3.39",
    "@angular/compiler-cli": "20.3.33",
    "@types/node": "^20.19.0",
    "angular-cli-ghpages": "^3.1.2",
    "typescript": "~5.8.3"
  }
}
